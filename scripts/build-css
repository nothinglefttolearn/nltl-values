#!/usr/bin/env python3
"""Generate css/nltl-values.css: every color and font token as a CSS custom
property on :root.

    scripts/build-css           # write the file
    scripts/build-css --check   # exit non-zero if the file is out of date (CI)

Names come from the token's dotted path with dots replaced by hyphens.
Only the brand and web color groups are written, without their group prefix
(brand.primary -> --primary, web.bg-raised -> --bg-raised); art colors are
for artwork, not websites, and are left out. Fonts get a font- prefix
(sans -> --font-sans). Aliases are written as the hex they resolve to.
"""
from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "css" / "nltl-values.css"

# Read the tokens through the Python loader in this checkout, so aliases are
# resolved exactly as consumers see them.
sys.path.insert(0, str(ROOT / "python"))
import nltl_values  # noqa: E402

# A family name that is a valid CSS identifier (SFMono-Regular, -apple-system,
# sans-serif) is written bare; anything else (Helvetica Neue) is quoted.
_IDENT = re.compile(r"^-?[A-Za-z_][A-Za-z0-9_-]*$")


def _family(name: str) -> str:
    return name if _IDENT.match(name) else '"' + name.replace('"', '\\"') + '"'


# Color groups written to the CSS file. Their prefix is dropped from the name.
CSS_COLOR_GROUPS = ("brand.", "web.")


def _var(path: str) -> str:
    return "--" + path.replace(".", "-")


def render() -> str:
    lines = [
        "/* Generated by scripts/build-css from tokens/. Do not edit by hand. */",
        ":root {",
    ]
    names: dict[str, str] = {}
    for path, hex_ in nltl_values.colors().items():
        group = next((g for g in CSS_COLOR_GROUPS if path.startswith(g)), None)
        if group is None:
            continue
        name = _var(path[len(group):])
        if name in names:
            raise SystemExit(f"build-css: {path!r} and {names[name]!r} both map to {name}")
        names[name] = path
        lines.append(f"  {name}: {hex_.lower()};")
    lines.append("")
    for path, stack in nltl_values.fonts().items():
        lines.append(f"  {_var('font.' + path)}: {', '.join(_family(f) for f in stack)};")
    lines.append("}")
    return "\n".join(lines) + "\n"


def main() -> int:
    css = render()
    if "--check" in sys.argv[1:]:
        if not OUT.is_file() or OUT.read_text("utf-8") != css:
            print(f"{OUT.relative_to(ROOT)} is out of date: run scripts/build-css", file=sys.stderr)
            return 1
        print(f"ok: {OUT.relative_to(ROOT)} is up to date")
        return 0
    OUT.parent.mkdir(exist_ok=True)
    OUT.write_text(css, encoding="utf-8")
    print(f"wrote {OUT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
